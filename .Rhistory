)
)
}) %>%
ungroup() %>%
filter(risk > 0) %>%
mutate(
delay_group = factor(delay_group)
)
missing_groups <- setdiff(
unique(type_lookup$delay_group),
levels(risk_data$delay_group)
)
if (length(missing_groups) > 0) {
stop(
"No mature observations for: ",
paste(missing_groups, collapse = ", ")
)
}
delay_model <- mgcv::gam(
cbind(hits, risk - hits) ~
delay_group +
s(
delay_week,
by = delay_group,
bs = "cr",
k = 4
),
data = risk_data,
family = binomial(link = "cloglog"),
method = "REML"
)
summary(delay_model)
delay_grid <- tidyr::expand_grid(
delay_group = levels(risk_data$delay_group),
delay_week = 0:D
) %>%
mutate(
delay_group = factor(
delay_group,
levels = levels(risk_data$delay_group)
)
)
delay_grid$hazard <- predict(
delay_model,
newdata = delay_grid,
type = "response"
)
delay_cdf <- delay_grid %>%
arrange(delay_group, delay_week) %>%
group_by(delay_group) %>%
mutate(
rho = 1 - cumprod(1 - hazard)
) %>%
ungroup() %>%
mutate(
delay_group = as.character(delay_group),
rho = pmin(1, pmax(0, rho))
)
View(delay_cdf)
type_cdf <- type_lookup %>%
left_join(
delay_cdf,
by = "delay_group",
relationship = "many-to-many"
) %>%
select(
event_type,
delay_week,
rho
)
ggplot(
delay_cdf,
aes(
x = delay_week,
y = rho,
color = delay_group
)
) +
geom_line(linewidth = 1) +
labs(
title = "Cameroon",
x = "Reporting delay (weeks)",
y = "Cumulative reporting probability",
color = "Event type"
) +
theme_bw()
historical_weeks <- T - 7 * (D + 0:(H - 1L))
library(dplyr)
library(tidyr)
library(purrr)
library(ggplot2)
library(mgcv)
library(lubridate)
T <- as.Date("2026-03-30")
D <- 20L
H <- 26L
L <- 15L
B <- 1000L
# Age required for fitting the delay distribution
M <- 52L
set.seed(123)
stopifnot(
D >= 1,
H >= 2,
L >= 1,
L <= D,
M >= D
)
week_T <- function(date) {
T - 7 * floor(
as.numeric(T - as.Date(date)) / 7
)
}
data <- readRDS("base_df.rds")
all_events <- data %>%
mutate(
event_date = as.Date(event_date),
timestamp_date = as.Date(timestamp_date),
event_type = as.character(event_type),
country = as.character(country)
) %>%
filter(
!is.na(id),
!is.na(country),
!is.na(event_type),
!is.na(event_date),
!is.na(timestamp_date),
timestamp_date >= event_date
) %>%
arrange(timestamp_date) %>%
distinct(id, .keep_all = TRUE) %>%
mutate(
occurence_week = week_T(event_date),
report_week = week_T(timestamp_date),
delay_week = as.integer(
(report_week - occurence_week) / 7
)
)
df <- all_events %>%
filter(
timestamp_date <= T,
event_date <= T,
delay_week >= 0
)
stopifnot(
nrow(df) > 0,
all(
as.numeric(df$report_week -
df$occurence_week) %% 7 == 0
)
)
mature <- df %>%
filter(
occurence_week <= T - 7 * M
)
stopifnot(nrow(mature) > 0)
type_sizes <- mature %>%
count(event_type, name = "n_type")
type_lookup <- df %>%
distinct(event_type) %>%
left_join(type_sizes, by = "event_type") %>%
mutate(
n_type = replace_na(n_type, 0L),
delay_group = if_else(
n_type >= 30,
event_type,
"Other"
)
) %>%
select(event_type, delay_group)
mature <- mature %>%
left_join(type_lookup, by = "event_type")
missing_groups <- setdiff(
unique(type_lookup$delay_group),
unique(mature$delay_group)
)
if (length(missing_groups) > 0) {
stop(
"No mature observations for delay group(s): ",
paste(missing_groups, collapse = ", ")
)
}
risk_data <- mature %>%
group_by(country, delay_group) %>%
group_modify(~ {
x <- .x$delay_week
tibble(
delay_week = 0:D,
hits = vapply(
0:D,
function(d) sum(x == d),
integer(1)
),
risk = vapply(
0:D,
function(d) sum(x >= d),
integer(1)
)
)
}) %>%
ungroup() %>%
filter(risk > 0) %>%
mutate(
country = factor(country),
delay_group = factor(delay_group)
)
censoring_summary <- mature %>%
summarise(
n_events = n(),
n_censored = sum(delay_week > D),
pct_censored = 100 * mean(delay_week > D)
)
print(censoring_summary)
delay_model <- mgcv::gam(
cbind(hits, risk - hits) ~
delay_group +
s(
delay_week,
by = delay_group,
bs = "cr",
k = 4
) +
country,
data = risk_data,
family = binomial(link = "cloglog"),
method = "REML"
)
summary(delay_model)
delay_grid <- tidyr::expand_grid(
country = levels(risk_data$country),
delay_group = levels(risk_data$delay_group),
delay_week = 0:D
) %>%
mutate(
country = factor(
country,
levels = levels(risk_data$country)
),
delay_group = factor(
delay_group,
levels = levels(risk_data$delay_group)
)
)
delay_grid$hazard <- predict(
delay_model,
newdata = delay_grid,
type = "response"
)
delay_cdf <- delay_grid %>%
arrange(
country,
delay_group,
delay_week
) %>%
group_by(country, delay_group) %>%
mutate(
rho = 1 - cumprod(1 - hazard)
) %>%
ungroup() %>%
mutate(
country = as.character(country),
delay_group = as.character(delay_group),
rho = pmin(1, pmax(0, rho))
) %>%
select(
country,
delay_group,
delay_week,
hazard,
rho
)
View(delay_cdf)
type_cdf <- type_lookup %>%
inner_join(
delay_cdf,
by = "delay_group",
relationship = "many-to-many"
)
ggplot(
delay_cdf,
aes(x = delay_week, y = rho, group = country)
) +
geom_line(alpha = 0.35) +
facet_wrap(~delay_group) +
labs(
x = "Reporting delay (weeks)",
y = "Cumulative reporting probability"
) +
theme_bw()
historical_weeks <- T - 7 * (D + 0:(H - 1L))
library(shiny); runApp('scripts/####Shiny_for_plot_delay.R')
library(shiny)
library(dplyr)
library(tidyr)
library(ggplot2)
library(lubridate)
# Load data
data <- readRDS("base_df.rds")
data <- data %>%
mutate(
timestamp_date = as.Date(
as.POSIXct(timestamp, origin = "1970-01-01", tz = "UTC")
),
delay = floor(as.numeric(timestamp_date - event_date) / 7),
occurence_week = floor_date(
event_date, unit = "week", week_start = 1
),
report_week = floor_date(
timestamp_date, unit = "week", week_start = 1
)
) %>%
mutate(delay = ifelse(delay > 20, 20, delay)) %>%
ungroup()
ui <- fluidPage(
titlePanel("Reporting Delays in Africa"),
sidebarLayout(
sidebarPanel(
selectInput(
inputId = "country",
label = "Select country",
choices = c(
"All countries",
sort(unique(data$country))
),
selected = "All countries"
),
downloadButton(
outputId = "download_plot",
label = "Download plot",
icon = icon("download")
),
width = 3
),
mainPanel(
plotOutput("delay_plot", height = "550px"),
width = 9
)
)
)
server <- function(input, output, session) {
filtered_data <- reactive({
df <- data
if (input$country != "All countries") {
df <- df %>%
filter(country == input$country)
}
df
})
delay_summary <- reactive({
filtered_data() %>%
filter(
occurence_week <=
max(occurence_week, na.rm = TRUE) - 20 * 7
) %>%
group_by(occurence_week) %>%
summarise(
n = n(),
median = median(delay, na.rm = TRUE),
q25 = quantile(delay, 0.25, na.rm = TRUE),
q75 = quantile(delay, 0.75, na.rm = TRUE),
.groups = "drop"
)
})
# Reusable plot
delay_plot <- reactive({
df_counts <- delay_summary()
# Scaling factor for secondary y-axis
scale_factor <- max(df_counts$n, na.rm = TRUE) /
max(1, df_counts$q75, na.rm = TRUE)
df1 <- df_counts %>%
pivot_longer(
cols = c(median, q25, q75),
names_to = "Statistic",
values_to = "Delay"
) %>%
mutate(
Statistic = factor(
Statistic,
levels = c("median", "q75", "q25"),
labels = c(
"Median",
"75th percentile",
"25th percentile"
)
)
)
ggplot() +
# Unsmoothed reporting-delay quantiles
geom_line(
data = df1,
aes(
x = occurence_week,
y = Delay,
color = Statistic,
linetype = Statistic
),
linewidth = 0.9
) +
# Smoothed weekly event counts
geom_smooth(
data = df_counts,
aes(
x = occurence_week,
y = n / scale_factor,
color = "Number of events",
linetype = "Number of events"
),
method = "loess",
formula = y ~ x,
span = 0.1,
se = FALSE,
linewidth = 1
) +
scale_color_manual(
values = c(
"Median" = "#0072B2",
"75th percentile" = "#D55E00",
"25th percentile" = "#009E73",
"Number of events" = "#555555"
),
breaks = c(
"Median",
"75th percentile",
"25th percentile",
"Number of events"
)
) +
scale_linetype_manual(
values = c(
"Median" = "solid",
"75th percentile" = "dashed",
"25th percentile" = "dashed",
"Number of events" = "solid"
),
breaks = c(
"Median",
"75th percentile",
"25th percentile",
"Number of events"
)
) +
# Dual y-axis
scale_y_continuous(
name = "Reporting delay (weeks)",
sec.axis = sec_axis(
~ . * scale_factor,
name = "Number of events"
)
) +
scale_x_date(
date_breaks = "2 months",
date_labels = "%b %Y"
) +
labs(
x = "Occurrence date",
color = NULL,
linetype = NULL
) +
theme_classic(
base_size = 11,
base_family = "serif"
) +
theme(
legend.position = "top",
legend.justification = "left",
panel.grid.major.y = element_line(
color = "grey90",
linewidth = 0.3
),
axis.text = element_text(color = "grey20"),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
axis.title.y.right = element_text(
color = "#555555"
),
legend.key.width = grid::unit(1.5, "cm")
)
})
# Display plot
output$delay_plot <- renderPlot({
delay_plot()
})
# Download PDF
output$download_plot <- downloadHandler(
filename = function() {
country_name <- if (input$country == "All countries") {
"Africa"
} else {
input$country
}
country_name <- gsub(
"[^A-Za-z0-9_-]", "_", country_name
)
paste0("reporting_delay_", country_name, ".pdf")
},
content = function(file) {
ggsave(
filename = file,
plot = delay_plot(),
device = "pdf",
width = 10,
height = 6,
units = "in",
bg = "white"
)
},
contentType = "application/pdf"
)
}
shinyApp(ui = ui, server = server)
